#include <stdio.h>
#define TAM 10
#define TAM_NAVIO 3

int main() 
{

    int tabuleiro[TAM][TAM];

    for(int i = 0; i < TAM; i++) 
    {
    for(int j = 0; j < TAM; j++) 
    {
    tabuleiro[i][j] = 0;
    }
    }

    int linhaH = 1, colunaH = 2;
    int linhaV = 4, colunaV = 6;
    int linhaDP = 0, colunaDP = 0;
    int linhaDS = 2, colunaDS = 8;

    int podePosicionar;

    if (colunaH + TAM_NAVIO <= TAM) 
    {
    podePosicionar = 1;
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    if(tabuleiro[linhaH][colunaH + i] != 0)
    podePosicionar = 0;
    }

    if(podePosicionar) 
    {
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    tabuleiro[linhaH][colunaH + i] = 3;
    }
    }
    }

    
    if (linhaV + TAM_NAVIO <= TAM) 
    {
    podePosicionar = 1;
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    if(tabuleiro[linhaV + i][colunaV] != 0)
    podePosicionar = 0;
    }

    if(podePosicionar) 
    {
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    tabuleiro[linhaV + i][colunaV] = 3;
    }
    }
    }

    
    if (linhaDP + TAM_NAVIO <= TAM && colunaDP + TAM_NAVIO <= TAM) 
    {
    podePosicionar = 1;
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    if(tabuleiro[linhaDP + i][colunaDP + i] != 0)
    podePosicionar = 0;
    }

    if(podePosicionar)
    {
    for(int i = 0; i < TAM_NAVIO; i++)
    {
    tabuleiro[linhaDP + i][colunaDP + i] = 3;
    }
    }
    }

    
    if (linhaDS + TAM_NAVIO <= TAM && colunaDS - (TAM_NAVIO - 1) >= 0) 
    {
    podePosicionar = 1;
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    if(tabuleiro[linhaDS + i][colunaDS - i] != 0)
    podePosicionar = 0;
    }

    if(podePosicionar) 
    {
    for(int i = 0; i < TAM_NAVIO; i++) 
    {
    tabuleiro[linhaDS + i][colunaDS - i] = 3;
    }
    }
    }

    printf("BATALHA NAVAL NIVEL AVENTUREIRO\n");

    for(int i = 0; i < TAM; i++) 
    {
    for(int j = 0; j < TAM; j++) 
    {
    printf("%d ", tabuleiro[i][j]);
    }
        printf("\n");
    }

    return 0;
}
